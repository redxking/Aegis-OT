{
  "$defs": {
    "WorkloadRole": {
      "enum": [
        "agent",
        "candidate",
        "gateway",
        "ot-adapter",
        "observer",
        "policy",
        "plant",
        "permit-issuer",
        "simulation"
      ],
      "title": "WorkloadRole",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Closed claims signed by the configured research identity authority.",
  "properties": {
    "audiences": {
      "items": {
        "type": "string"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Audiences",
      "type": "array"
    },
    "authority_key_id": {
      "maxLength": 128,
      "minLength": 3,
      "title": "Authority Key Id",
      "type": "string"
    },
    "credential_id": {
      "maxLength": 128,
      "minLength": 16,
      "title": "Credential Id",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "issued_at": {
      "format": "date-time",
      "title": "Issued At",
      "type": "string"
    },
    "key_id": {
      "maxLength": 128,
      "minLength": 3,
      "title": "Key Id",
      "type": "string"
    },
    "not_before": {
      "format": "date-time",
      "title": "Not Before",
      "type": "string"
    },
    "public_key_b64": {
      "maxLength": 44,
      "minLength": 44,
      "title": "Public Key B64",
      "type": "string"
    },
    "role": {
      "$ref": "#/$defs/WorkloadRole"
    },
    "schema_version": {
      "default": "m4g-workload-credential-v1",
      "pattern": "^m4g-workload-credential-v1$",
      "title": "Schema Version",
      "type": "string"
    },
    "subject": {
      "maxLength": 256,
      "minLength": 3,
      "title": "Subject",
      "type": "string"
    },
    "trust_domain": {
      "maxLength": 128,
      "minLength": 3,
      "title": "Trust Domain",
      "type": "string"
    }
  },
  "required": [
    "credential_id",
    "trust_domain",
    "subject",
    "role",
    "key_id",
    "public_key_b64",
    "authority_key_id",
    "audiences",
    "issued_at",
    "not_before",
    "expires_at"
  ],
  "title": "WorkloadCredential",
  "type": "object"
}
