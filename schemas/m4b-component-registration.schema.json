{
  "$defs": {
    "M4bComponentRole": {
      "enum": [
        "plant",
        "observer",
        "plc",
        "replacement_plc",
        "permit_signer",
        "independent_evaluator"
      ],
      "title": "M4bComponentRole",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "One process instance, boot epoch, key identity, and capability inventory.",
  "properties": {
    "boot_epoch": {
      "maxLength": 256,
      "minLength": 16,
      "title": "Boot Epoch",
      "type": "string"
    },
    "capabilities": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Capabilities",
      "type": "array"
    },
    "component_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Component Id",
      "type": "string"
    },
    "key_id": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Key Id"
    },
    "master_seed": {
      "minimum": 0,
      "title": "Master Seed",
      "type": "integer"
    },
    "model_digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Digest"
    },
    "pid": {
      "minimum": 1,
      "title": "Pid",
      "type": "integer"
    },
    "plant_boot_epoch": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 16,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Plant Boot Epoch"
    },
    "public_key_b64": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Public Key B64"
    },
    "public_key_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Public Key Sha256"
    },
    "registered_at": {
      "format": "date-time",
      "title": "Registered At",
      "type": "string"
    },
    "role": {
      "$ref": "#/$defs/M4bComponentRole"
    },
    "schema_version": {
      "const": "m4b-component-registration-v1",
      "default": "m4b-component-registration-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "session_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Session Id",
      "type": "string"
    },
    "session_index": {
      "minimum": 0,
      "title": "Session Index",
      "type": "integer"
    }
  },
  "required": [
    "session_id",
    "session_index",
    "master_seed",
    "role",
    "component_id",
    "pid",
    "boot_epoch",
    "capabilities",
    "registered_at"
  ],
  "title": "M4bComponentRegistration",
  "type": "object"
}
