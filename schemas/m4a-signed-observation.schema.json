{
  "$defs": {
    "ObservationPhase": {
      "enum": [
        "pre_authorization",
        "post_dispatch"
      ],
      "title": "ObservationPhase",
      "type": "string"
    },
    "PhysicalStateSnapshot": {
      "additionalProperties": false,
      "description": "Authoritative, versioned steady-state result returned by the plant model.",
      "properties": {
        "battery_injection_mw": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Battery Injection Mw",
          "type": "object"
        },
        "bus_voltage_pu": {
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Bus Voltage Pu",
          "type": "array"
        },
        "converged": {
          "title": "Converged",
          "type": "boolean"
        },
        "input_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Digest",
          "type": "string"
        },
        "isolated_resources": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Isolated Resources",
          "type": "array"
        },
        "line_loading_pct": {
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Line Loading Pct",
          "type": "array"
        },
        "maximum_line_loading_pct": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum Line Loading Pct"
        },
        "maximum_voltage_pu": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum Voltage Pu"
        },
        "minimum_voltage_pu": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum Voltage Pu"
        },
        "model_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Model Digest",
          "type": "string"
        },
        "model_id": {
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "observation_clock_domain": {
          "minLength": 1,
          "title": "Observation Clock Domain",
          "type": "string"
        },
        "observation_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Observation Digest",
          "type": "string"
        },
        "observation_sequence": {
          "minimum": 0,
          "title": "Observation Sequence",
          "type": "integer"
        },
        "observation_source_id": {
          "minLength": 1,
          "title": "Observation Source Id",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "priority_load_demand_mw": {
          "minimum": 0,
          "title": "Priority Load Demand Mw",
          "type": "number"
        },
        "priority_load_served_mw": {
          "minimum": 0,
          "title": "Priority Load Served Mw",
          "type": "number"
        },
        "priority_load_served_pct": {
          "maximum": 100,
          "minimum": 0,
          "title": "Priority Load Served Pct",
          "type": "number"
        },
        "schema_version": {
          "const": "physical-state-v1",
          "default": "physical-state-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "served_load_mw": {
          "minimum": 0,
          "title": "Served Load Mw",
          "type": "number"
        },
        "simulation_time_s": {
          "minimum": 0,
          "title": "Simulation Time S",
          "type": "number"
        },
        "simulator_version": {
          "minLength": 1,
          "title": "Simulator Version",
          "type": "string"
        },
        "state_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "State Digest",
          "type": "string"
        },
        "state_version": {
          "minimum": 0,
          "title": "State Version",
          "type": "integer"
        },
        "thermal_violation_count": {
          "minimum": 0,
          "title": "Thermal Violation Count",
          "type": "integer"
        },
        "topology_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Topology Digest",
          "type": "string"
        },
        "total_load_demand_mw": {
          "minimum": 0,
          "title": "Total Load Demand Mw",
          "type": "number"
        },
        "total_load_served_pct": {
          "maximum": 100,
          "minimum": 0,
          "title": "Total Load Served Pct",
          "type": "number"
        },
        "unsafe_state": {
          "title": "Unsafe State",
          "type": "boolean"
        },
        "unserved_load_mw": {
          "minimum": 0,
          "title": "Unserved Load Mw",
          "type": "number"
        },
        "voltage_violation_count": {
          "minimum": 0,
          "title": "Voltage Violation Count",
          "type": "integer"
        }
      },
      "required": [
        "model_id",
        "simulator_version",
        "model_digest",
        "input_digest",
        "topology_digest",
        "state_digest",
        "observation_digest",
        "observation_sequence",
        "observation_source_id",
        "observation_clock_domain",
        "state_version",
        "simulation_time_s",
        "observed_at",
        "converged",
        "total_load_demand_mw",
        "served_load_mw",
        "unserved_load_mw",
        "total_load_served_pct",
        "priority_load_demand_mw",
        "priority_load_served_mw",
        "priority_load_served_pct",
        "voltage_violation_count",
        "thermal_violation_count",
        "unsafe_state",
        "bus_voltage_pu",
        "line_loading_pct"
      ],
      "title": "PhysicalStateSnapshot",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Observer-signed state artifact with boot, sequence, time, and correlation binding.",
  "properties": {
    "captured_at": {
      "format": "date-time",
      "title": "Captured At",
      "type": "string"
    },
    "challenge_nonce": {
      "maxLength": 256,
      "minLength": 16,
      "title": "Challenge Nonce",
      "type": "string"
    },
    "command_digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Command Digest"
    },
    "correlation_id": {
      "minLength": 1,
      "title": "Correlation Id",
      "type": "string"
    },
    "envelope_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Envelope Digest",
      "type": "string"
    },
    "logical_time_s": {
      "minimum": 0,
      "title": "Logical Time S",
      "type": "number"
    },
    "observation_id": {
      "minLength": 1,
      "title": "Observation Id",
      "type": "string"
    },
    "observer_boot_epoch": {
      "minLength": 16,
      "title": "Observer Boot Epoch",
      "type": "string"
    },
    "observer_id": {
      "minLength": 1,
      "title": "Observer Id",
      "type": "string"
    },
    "observer_key_id": {
      "minLength": 1,
      "title": "Observer Key Id",
      "type": "string"
    },
    "observer_sequence": {
      "minimum": 1,
      "title": "Observer Sequence",
      "type": "integer"
    },
    "permit_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Permit Id"
    },
    "phase": {
      "$ref": "#/$defs/ObservationPhase"
    },
    "plc_acknowledgment_digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Plc Acknowledgment Digest"
    },
    "previous_envelope_digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "For a post-dispatch observation, the exact pre-authorization envelope for the same transaction; it is not a continuous global-chain claim.",
      "title": "Previous Envelope Digest"
    },
    "schema_version": {
      "const": "signed-observation-v1",
      "default": "signed-observation-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "signature": {
      "default": "",
      "title": "Signature",
      "type": "string"
    },
    "snapshot": {
      "$ref": "#/$defs/PhysicalStateSnapshot"
    }
  },
  "required": [
    "correlation_id",
    "phase",
    "challenge_nonce",
    "observer_id",
    "observer_key_id",
    "observer_boot_epoch",
    "observer_sequence",
    "captured_at",
    "logical_time_s",
    "snapshot",
    "envelope_digest"
  ],
  "title": "SignedObservationEnvelope",
  "type": "object"
}
