{
  "$defs": {
    "PhysicalStateSnapshot": {
      "additionalProperties": false,
      "description": "Authoritative, versioned steady-state result returned by the plant model.",
      "properties": {
        "battery_injection_mw": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Battery Injection Mw",
          "type": "object"
        },
        "bus_voltage_pu": {
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Bus Voltage Pu",
          "type": "array"
        },
        "converged": {
          "title": "Converged",
          "type": "boolean"
        },
        "input_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Digest",
          "type": "string"
        },
        "isolated_resources": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Isolated Resources",
          "type": "array"
        },
        "line_loading_pct": {
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Line Loading Pct",
          "type": "array"
        },
        "maximum_line_loading_pct": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum Line Loading Pct"
        },
        "maximum_voltage_pu": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum Voltage Pu"
        },
        "minimum_voltage_pu": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum Voltage Pu"
        },
        "model_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Model Digest",
          "type": "string"
        },
        "model_id": {
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "observation_clock_domain": {
          "minLength": 1,
          "title": "Observation Clock Domain",
          "type": "string"
        },
        "observation_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Observation Digest",
          "type": "string"
        },
        "observation_sequence": {
          "minimum": 0,
          "title": "Observation Sequence",
          "type": "integer"
        },
        "observation_source_id": {
          "minLength": 1,
          "title": "Observation Source Id",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "priority_load_demand_mw": {
          "minimum": 0,
          "title": "Priority Load Demand Mw",
          "type": "number"
        },
        "priority_load_served_mw": {
          "minimum": 0,
          "title": "Priority Load Served Mw",
          "type": "number"
        },
        "priority_load_served_pct": {
          "maximum": 100,
          "minimum": 0,
          "title": "Priority Load Served Pct",
          "type": "number"
        },
        "schema_version": {
          "const": "physical-state-v1",
          "default": "physical-state-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "served_load_mw": {
          "minimum": 0,
          "title": "Served Load Mw",
          "type": "number"
        },
        "simulation_time_s": {
          "minimum": 0,
          "title": "Simulation Time S",
          "type": "number"
        },
        "simulator_version": {
          "minLength": 1,
          "title": "Simulator Version",
          "type": "string"
        },
        "state_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "State Digest",
          "type": "string"
        },
        "state_version": {
          "minimum": 0,
          "title": "State Version",
          "type": "integer"
        },
        "thermal_violation_count": {
          "minimum": 0,
          "title": "Thermal Violation Count",
          "type": "integer"
        },
        "topology_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Topology Digest",
          "type": "string"
        },
        "total_load_demand_mw": {
          "minimum": 0,
          "title": "Total Load Demand Mw",
          "type": "number"
        },
        "total_load_served_pct": {
          "maximum": 100,
          "minimum": 0,
          "title": "Total Load Served Pct",
          "type": "number"
        },
        "unsafe_state": {
          "title": "Unsafe State",
          "type": "boolean"
        },
        "unserved_load_mw": {
          "minimum": 0,
          "title": "Unserved Load Mw",
          "type": "number"
        },
        "voltage_violation_count": {
          "minimum": 0,
          "title": "Voltage Violation Count",
          "type": "integer"
        }
      },
      "required": [
        "model_id",
        "simulator_version",
        "model_digest",
        "input_digest",
        "topology_digest",
        "state_digest",
        "observation_digest",
        "observation_sequence",
        "observation_source_id",
        "observation_clock_domain",
        "state_version",
        "simulation_time_s",
        "observed_at",
        "converged",
        "total_load_demand_mw",
        "served_load_mw",
        "unserved_load_mw",
        "total_load_served_pct",
        "priority_load_demand_mw",
        "priority_load_served_mw",
        "priority_load_served_pct",
        "voltage_violation_count",
        "thermal_violation_count",
        "unsafe_state",
        "bus_voltage_pu",
        "line_loading_pct"
      ],
      "title": "PhysicalStateSnapshot",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Independent candidate power-flow result used before permit issuance.",
  "properties": {
    "assessment_id": {
      "minLength": 1,
      "title": "Assessment Id",
      "type": "string"
    },
    "command_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Command Digest",
      "type": "string"
    },
    "post_state": {
      "$ref": "#/$defs/PhysicalStateSnapshot"
    },
    "pre_state": {
      "$ref": "#/$defs/PhysicalStateSnapshot"
    },
    "reasons": {
      "items": {
        "type": "string"
      },
      "title": "Reasons",
      "type": "array"
    },
    "safe": {
      "title": "Safe",
      "type": "boolean"
    },
    "schema_version": {
      "const": "candidate-assessment-v1",
      "default": "candidate-assessment-v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "command_digest",
    "pre_state",
    "post_state",
    "safe",
    "reasons"
  ],
  "title": "CandidateAssessment",
  "type": "object"
}
