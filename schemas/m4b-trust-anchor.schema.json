{
  "additionalProperties": false,
  "description": "Package root public key and its bounded validity interval.",
  "properties": {
    "anchor_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Anchor Id",
      "type": "string"
    },
    "key_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Key Id",
      "type": "string"
    },
    "not_after": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Not After"
    },
    "not_before": {
      "format": "date-time",
      "title": "Not Before",
      "type": "string"
    },
    "public_key_b64": {
      "title": "Public Key B64",
      "type": "string"
    },
    "public_key_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Public Key Sha256",
      "type": "string"
    },
    "purpose": {
      "const": "m4b-evidence-root",
      "default": "m4b-evidence-root",
      "title": "Purpose",
      "type": "string"
    },
    "schema_version": {
      "const": "m4b-trust-anchor-v1",
      "default": "m4b-trust-anchor-v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "anchor_id",
    "key_id",
    "public_key_b64",
    "public_key_sha256",
    "not_before"
  ],
  "title": "M4bTrustAnchor",
  "type": "object"
}
